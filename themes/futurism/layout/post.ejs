<article class="post container">

  <!-- 阅读进度条 -->
  <% if (theme.post.toc) { %>
  <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
  <% } %>

  <div class="post-layout">

    <!-- TOC 侧边栏 -->
    <% if (theme.post.toc && toc(page.content).length > 0) { %>
    <aside class="toc-sidebar" id="tocSidebar" aria-label="文章目录">
      <div class="toc-title">目录</div>
      <%- toc(page.content, { list_number: false, max_depth: theme.post.toc_depth || 3 }) %>
    </aside>
    <% } %>

    <!-- 文章主体 -->
    <div class="post-body">

      <!-- 面包屑导航 -->
      <nav class="breadcrumb" aria-label="面包屑导航">
        <a href="<%- url_for('/') %>">首页</a>
        <span class="breadcrumb__sep">›</span>
        <% if (page.categories && page.categories.length) { %>
          <% page.categories.forEach(function(cat, i) { %>
            <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
            <span class="breadcrumb__sep">›</span>
          <% }) %>
        <% } %>
        <span class="breadcrumb__current"><%= page.title %></span>
      </nav>

      <!-- 文章头部 -->
      <header class="post-header">
        <h1 class="post-header__title"><%= page.title %></h1>

        <div class="post-header__meta">
          <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>">
            📅 发布于 <%= date(page.date, 'YYYY-MM-DD') %>
          </time>
          <% if (page.updated && page.updated !== page.date) { %>
          <time datetime="<%= date(page.updated, 'YYYY-MM-DD') %>">
            · 更新于 <%= date(page.updated, 'YYYY-MM-DD') %>
          </time>
          <% } %>
          <% if (theme.post.word_count) { %>
          <span>📝 <%= wordcount(page.content) %> 字</span>
          <% } %>
          <% if (theme.post.reading_time) { %>
          <span>⏱ <%= min2read(page.content) %> 分钟阅读</span>
          <% } %>
        </div>

        <% if (page.categories && page.categories.length) { %>
        <div class="post-header__categories">
          <% page.categories.forEach(function(cat) { %>
            <a href="<%- url_for(cat.path) %>" class="post-category-chip"><%= cat.name %></a>
          <% }) %>
        </div>
        <% } %>

        <% if (page.cover) { %>
        <div class="post-header__cover">
          <img src="<%- url_for(page.cover) %>" alt="<%= page.title %>" loading="lazy">
        </div>
        <% } %>
      </header>

      <!-- 文章正文 -->
      <div class="post-content prose" id="post-content">
        <%- page.content %>
      </div>

      <!-- 文章标签 -->
      <% if (page.tags && page.tags.length) { %>
      <div class="post-tags">
        <% page.tags.forEach(function(tag) { %>
          <a href="<%- url_for(tag.path) %>" class="tag-chip">#<%= tag.name %></a>
        <% }) %>
      </div>
      <% } %>

      <!-- 分享按钮 -->
      <div class="post-share">
        <span class="post-share__label">分享文章：</span>
        <button class="post-share__btn post-share__btn--copy" onclick="copyLink()" title="复制链接">
          🔗 复制链接
        </button>
        <a class="post-share__btn post-share__btn--twitter"
           href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(page.title) %>&url=<%= encodeURIComponent(page.permalink) %>"
           target="_blank" rel="noopener noreferrer" title="分享到 Twitter">
          🐦 Twitter
        </a>
        <a class="post-share__btn post-share__btn--weibo"
           href="https://service.weibo.com/share/share.php?title=<%= encodeURIComponent(page.title) %>&url=<%= encodeURIComponent(page.permalink) %>"
           target="_blank" rel="noopener noreferrer" title="分享到微博">
          📢 微博
        </a>
      </div>

      <!-- 相关文章推荐 -->
      <%
        var relatedPosts = [];
        if (page.tags && page.tags.length) {
          var currentTags = page.tags.map(function(t) { return t.name; });
          site.posts.forEach(function(post) {
            if (post.path === page.path) return;
            if (!post.tags || !post.tags.length) return;
            var postTags = post.tags.map(function(t) { return t.name; });
            var matchCount = 0;
            currentTags.forEach(function(tag) {
              if (postTags.indexOf(tag) !== -1) matchCount++;
            });
            if (matchCount > 0) {
              relatedPosts.push({ post: post, score: matchCount });
            }
          });
          relatedPosts.sort(function(a, b) { return b.score - a.score; });
          relatedPosts = relatedPosts.slice(0, 3).map(function(item) { return item.post; });
        }
      %>
      <% if (relatedPosts.length > 0) { %>
      <section class="related-posts">
        <h2 class="related-posts__title">📖 相关推荐</h2>
        <div class="related-posts__grid">
          <% relatedPosts.forEach(function(post) { %>
          <a href="<%- url_for(post.path) %>" class="related-posts__card">
            <span class="related-posts__card-title"><%= post.title %></span>
            <span class="related-posts__card-meta">
              📅 <%= date(post.date, 'YYYY-MM-DD') %>
              <% if (theme.post.reading_time) { %>
                · ⏱ <%= min2read(post.content) %> 分钟
              <% } %>
            </span>
          </a>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- 版权声明 -->
      <% if (theme.post.copyright && theme.post.copyright.enable) { %>
      <div class="post-copyright">
        <p>
          © <%= theme.post.copyright.author %> ·
          <a href="<%= theme.post.copyright.link %>"><%= theme.post.copyright.link %></a>
          <br>
          原创内容，转载请注明出处。
        </p>
      </div>
      <% } %>

      <!-- 上一篇 / 下一篇 -->
      <% if (theme.post_pagination) { %>
      <nav class="post-nav" aria-label="文章导航">
        <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>" class="post-nav__item post-nav__prev">
          <span class="post-nav__label">← 上一篇</span>
          <span class="post-nav__title"><%= page.prev.title %></span>
        </a>
        <% } %>
        <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>" class="post-nav__item post-nav__next">
          <span class="post-nav__label">下一篇 →</span>
          <span class="post-nav__title"><%= page.next.title %></span>
        </a>
        <% } %>
      </nav>
      <% } %>

      <!-- 评论区 -->
      <% if (theme.comments.enable && theme.comments.provider === 'giscus') { %>
      <div id="comments" class="post-comments">
        <script src="https://giscus.app/client.js"
          data-repo="<%= theme.giscus.repo %>"
          data-repo-id="<%= theme.giscus.repo_id %>"
          data-category="<%= theme.giscus.category %>"
          data-category-id="<%= theme.giscus.category_id %>"
          data-mapping="<%= theme.giscus.mapping %>"
          data-reactions-enabled="<%= theme.giscus.reactions_enabled %>"
          data-emit-metadata="<%= theme.giscus.emit_metadata %>"
          data-theme="<%= theme.giscus.theme %>"
          data-lang="<%= theme.giscus.lang %>"
          crossorigin="anonymous"
          async>
        </script>
      </div>
      <% } %>

    </div>
  </div>

  <!-- 移动端 TOC 抽屉 -->
  <% if (theme.post.toc && toc(page.content).length > 0) { %>
  <button class="toc-mobile-trigger" id="tocMobileTrigger" aria-label="文章目录" title="文章目录">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="15" y2="12"/><line x1="3" y1="18" x2="18" y2="18"/>
    </svg>
  </button>
  <div class="toc-drawer-overlay" id="tocDrawerOverlay">
    <div class="toc-drawer" id="tocDrawer">
      <div class="toc-drawer__header">
        <span class="toc-drawer__title">目录</span>
        <button class="toc-drawer__close" id="tocDrawerClose" aria-label="关闭目录">&times;</button>
      </div>
      <div class="toc-drawer__content">
        <%- toc(page.content, { list_number: false, max_depth: theme.post.toc_depth || 3 }) %>
      </div>
    </div>
  </div>
  <script>
  (function() {
    var trigger = document.getElementById('tocMobileTrigger');
    var overlay = document.getElementById('tocDrawerOverlay');
    var drawer = document.getElementById('tocDrawer');
    var closeBtn = document.getElementById('tocDrawerClose');
    if (!trigger || !overlay) return;

    function openDrawer() {
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openDrawer);
    closeBtn && closeBtn.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeDrawer();
    });
    drawer && drawer.addEventListener('click', function(e) {
      e.stopPropagation();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeDrawer();
    });
    window.addEventListener('resize', function() {
      if (window.innerWidth > 1024 && overlay.classList.contains('is-open')) closeDrawer();
    });
  })();
  </script>
  <% } %>
</article>
