<div class="taxonomy container">
  <nav class="breadcrumb" aria-label="面包屑导航">
    <a href="<%- url_for('/') %>">首页</a>
    <span class="breadcrumb__sep">›</span>
    <span class="breadcrumb__current">分类</span>
  </nav>

  <h1 class="taxonomy__title">
    <span class="taxonomy__icon">📂</span> 所有分类
  </h1>
  <p class="taxonomy__count">共 <%= site.categories.length %> 个分类</p>

  <section class="taxonomy-all">
    <div class="tag-cloud">
      <% site.categories.sort('name').forEach(function(cat) { %>
        <a href="<%- url_for(cat.path) %>" class="tag-chip">
          📂 <%= cat.name %> <span class="tag-count"><%= cat.length %></span>
        </a>
      <% }) %>
    </div>
  </section>

  <% site.categories.sort('name').forEach(function(cat) { %>
  <section class="archive-year">
    <h2 class="archive-year__title">
      <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
      <span class="tag-count">(<%= cat.length %>)</span>
    </h2>
    <ul class="archive-year__list">
      <% cat.posts.sort('date', -1).forEach(function(post) { %>
      <li class="archive-item">
        <time class="archive-item__date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>">
          <%= date(post.date, 'MM-DD') %>
        </time>
        <a href="<%- url_for(post.path) %>" class="archive-item__title"><%= post.title %></a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% }) %>
</div>
